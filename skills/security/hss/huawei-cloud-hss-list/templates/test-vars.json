{
  "test_cases": [
    {
      "id": "TC-01",
      "name": "HSS ListHostStatus 主机防护列表 (read-only)",
      "command": "hcloud HSS ListHostStatus --cli-region={region} --limit=10 --offset=0",
      "expected": "JSON total_num + data_list of protected hosts or error envelope",
      "type": "readonly",
      "executor": "cli"
    },
    {
      "id": "TC-02",
      "name": "HSS host list filtered by agent status online (read-only)",
      "command": "hcloud HSS ListHostStatus --cli-region={region} --agent_status=online --limit=10",
      "expected": "JSON host list filtered by agent status",
      "type": "readonly",
      "executor": "cli"
    },
    {
