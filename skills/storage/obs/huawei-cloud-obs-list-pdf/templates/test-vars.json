{
  "skill_name": "huawei-cloud-obs-list-pdf",
  "region": "cn-north-4",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "Export PDF report (default format)",
      "command": "python3 scripts/list_obs_buckets_pdf.py --region {region} --output /tmp/obs_buckets_{region}.pdf --summary",
      "expected": "Prints generated .pdf path; PDF has header + data rows + summary row",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-02",
      "name": "Table output (script)",
      "command": "python3 scripts/list_obs_buckets_pdf.py --region {region} --format table",
      "expected": "Aligned table with name/creation_date/location columns",
      "type": "readonly",
      "executor": "sdk"
    },
    {
      "id": "TC-03",
      "name": "Bucket list as JSON (script)",
      "command": "python3 scripts/list_obs_buckets_pdf.py --region {region} --format json",
      "expected": "JSON array of {name, [creation_date], [location], [storage_class], [policy]}",
      "type": "readonly",
      "executor": "sdk"
    },
    {
      "id": "TC-04",
      "name": "Empty result produces no file",
      "command": "python3 scripts/list_obs_buckets_pdf.py --region {region} --format pdf --output /tmp/nonexistent_dir_empty/out.pdf",
      "expected": "No OBS buckets → friendly message, exit 0, no .pdf created",
      "type": "readonly",
      "executor": "sdk"
    },
    {
      "id": "TC-05",
      "name": "Argument help (syntax)",
      "command": "python3 scripts/list_obs_buckets_pdf.py --help",
      "expected": "argparse help printed, exit 0",
      "type": "syntax",
      "executor": "sdk"
    }
  ],
  "env_vars_required": ["HW_ACCESS_KEY", "HW_SECRET_KEY"],
  "notes": "只读操作（ListBuckets），无资源创建/修改/删除风险；PDF 仅在本机生成，绝不写回 OBS。CLI 路径使用 hcloud OBS（obsutil）的 ls；SDK 回退使用 huaweicloudsdkobs；PDF 后端 reportlab 优先、fpdf2 兜底，缺失时运行 scripts/ensure_env.py 自动安装。"
}